{
  "name": "video-note-generator-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:api && tsc --noEmit && vite build",
    "generate:api": "node scripts/generate-api-types.mjs --write",
    "check:api": "node scripts/generate-api-types.mjs --check",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
